PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-32chars
# Supabase Postgres (preferred for live - no Disk needed, works on Vercel/Render free)
# Get from Supabase Dashboard → Project Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Supabase API (optional — for future Auth/Storage/Realtime via supabase-js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Optional: fallback SQLite for local dev without Supabase
DATABASE_PATH=./db/checksheet.db
# On Render Disk (SQLite fallback): set DATABASE_PATH=/data/checksheet.db and attach Disk at /data
NODE_ENV=production
