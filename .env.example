[TEMPLATE]
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-32chars

# ===== FREE DATABASE (Neon) =====
# Step 1: Sign up at https://neon.tech (free, no credit card)
# Step 2: Create a project → Copy the connection string from Connection Details
# Step 3: Paste below as DATABASE_URL
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# SQLite fallback for local dev only (not for Vercel)
DATABASE_PATH=./db/checksheet.db

# On Render Disk (SQLite fallback): set DATABASE_PATH=/data/checksheet.db and attach Disk at /data
NODE_ENV=production
